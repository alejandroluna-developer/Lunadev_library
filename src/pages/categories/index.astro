---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumbs from '../../components/molecules/Breadcrumbs.astro';
import CategoryCard from '../../components/organisms/CategoryCard.astro';
import TagList from '../../components/molecules/TagList.astro';
import Icon from '../../components/atoms/Icon.astro';
import { categories, getCategoryPromptCount } from '../../data/categories';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Categories' },
];

const categoriesWithCounts = await Promise.all(
  categories.map(async (category) => ({
    ...category,
    promptCount: await getCategoryPromptCount(category.slug),
  }))
);
---

<MainLayout title="Explore Categories — LunaPrompt" currentPath="/categories">
  <Breadcrumbs items={breadcrumbs} />

  <section class="page-header">
    <h1 class="page-header__title">System Categories</h1>
    <p class="page-header__description">
      Navigate through our specialized engineering domains. Each category contains curated prompts optimized for production workflows.
    </p>
  </section>

  <section class="categories-grid">
    {categoriesWithCounts.map((category) => (
      <div class="category-item">
        <a href={`/categories/${category.slug}`} class="category-large-card">
          <div class="category-large-card__header">
            <div class="category-large-card__icon">
              <Icon name={category.icon} size={28} />
            </div>
            <span class="category-large-card__count">{category.promptCount} prompts</span>
          </div>
          <h3 class="category-large-card__title">{category.name}</h3>
          <p class="category-large-card__description">{category.description}</p>
          {category.tags && (
            <TagList tags={category.tags} variant="outline" />
          )}
        </a>
      </div>
    ))}
  </section>
</MainLayout>

<style>
  .page-header {
    margin: var(--space-8) 0;
  }

  .page-header__title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .page-header__description {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 600px;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .category-large-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-8);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-xl);
    text-decoration: none;
    transition: all var(--transition-normal);
  }

  .category-large-card:hover {
    background: var(--color-bg-card-hover);
    border-color: var(--color-border-default);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .category-large-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .category-large-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background: var(--color-accent-subtle);
    border: 1px solid var(--color-tag-border);
    border-radius: var(--radius-lg);
    color: var(--color-accent-secondary);
  }

  .category-large-card__count {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .category-large-card__title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
  }

  .category-large-card__description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 768px) {
    .categories-grid {
      grid-template-columns: 1fr;
    }

    .page-header__title {
      font-size: var(--text-3xl);
    }
  }
</style>
