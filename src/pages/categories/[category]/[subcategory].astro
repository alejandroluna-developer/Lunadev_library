---
import MainLayout from '../../../layouts/MainLayout.astro';
import Breadcrumbs from '../../../components/molecules/Breadcrumbs.astro';
import PromptCard from '../../../components/organisms/PromptCard.astro';
import FeaturedCard from '../../../components/organisms/FeaturedCard.astro';
import Button from '../../../components/atoms/Button.astro';
import Icon from '../../../components/atoms/Icon.astro';
import { categories, getCategoryBySlug, getSubcategoryBySlug } from '../../../data/categories';
import { getPromptsBySubcategory, getFeaturedPrompts, getProjectsInSubcategory } from '../../../data/prompts';

export function getStaticPaths() {
  const paths: { params: { category: string; subcategory: string } }[] = [];
  categories.forEach((cat) => {
    cat.subcategories?.forEach((sub) => {
      paths.push({ params: { category: cat.slug, subcategory: sub.slug } });
    });
  });
  return paths;
}

const { category: catSlug, subcategory: subSlug } = Astro.params;
const category = getCategoryBySlug(catSlug!);
const subcategory = getSubcategoryBySlug(catSlug!, subSlug!);

if (!category || !subcategory) {
  return Astro.redirect('/404');
}

const prompts = await getPromptsBySubcategory(subcategory.slug);
const projects = await getProjectsInSubcategory(subcategory.slug);
const allFeatured = await getFeaturedPrompts();
const featuredPrompt = allFeatured.find(p => p.subcategorySlug === subcategory.slug);

const hasProjects = projects.length > 0;
const nonProjectPrompts = prompts.filter((p) => !p.project);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: category.name, href: `/categories/${category.slug}` },
  { label: subcategory.name },
];
---

<MainLayout
  title={`${subcategory.name} — ${category.name} — LunaPrompt`}
  currentPath={`/categories/${category.slug}`}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="page-header">
    <div class="page-header__content">
      <h1 class="page-header__title">{subcategory.name}</h1>
      <p class="page-header__description">{subcategory.description}</p>
    </div>
    <div class="page-header__actions">
      <Button variant="outline" size="sm">
        <Icon name="filter" size={14} />
        <span>Filter</span>
      </Button>
      <Button variant="outline" size="sm">
        <Icon name="clock" size={14} />
        <span>Recent</span>
      </Button>
    </div>
  </section>

  {hasProjects && (
    <section class="projects-grid">
      {projects.map((project) => (
        <a class="project-card" href={`/categories/${category.slug}/${subcategory.slug}/${project.slug}`}>
          <div class="project-card__icon">
            <Icon name="code" size={20} />
          </div>
          <div class="project-card__content">
            <h3 class="project-card__title">{project.name}</h3>
            {project.description && (
              <p class="project-card__description">{project.description}</p>
            )}
            <span class="project-card__meta">{project.promptCount} {project.promptCount === 1 ? 'prompt' : 'prompts'}</span>
          </div>
          <div class="project-card__arrow">
            <Icon name="arrow-right" size={16} />
          </div>
        </a>
      ))}
    </section>
  )}

  {nonProjectPrompts.length > 0 && (
    <section class="prompts-grid">
      {nonProjectPrompts.map((prompt) => (
        <PromptCard
          prompt={prompt}
          variant={prompt.isFeatured ? 'featured' : 'default'}
        />
      ))}
    </section>
  )}

  {featuredPrompt && (
    <section class="featured-section">
      <FeaturedCard prompt={featuredPrompt} />
    </section>
  )}

  {prompts.length === 0 && projects.length === 0 && (
    <section class="empty-state">
      <Icon name="search" size={48} class="empty-state__icon" />
      <h3 class="empty-state__title">No prompts yet</h3>
      <p class="empty-state__description">
        Prompts for this subcategory are being curated. Check back soon.
      </p>
      <Button variant="secondary" href={`/categories/${category.slug}`}>
        <span>Browse {category.name}</span>
      </Button>
    </section>
  )}

  {prompts.length > 6 && (
    <div class="load-more">
      <p class="load-more__text">Showing {prompts.length} of {prompts.length} prompts</p>
      <Button variant="outline">Load More</Button>
    </div>
  )}
</MainLayout>

<style>
  .page-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin: var(--space-8) 0 var(--space-6);
  }

  .page-header__title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }

  .page-header__description {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    max-width: 600px;
  }

  .page-header__actions {
    display: flex;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .prompts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .projects-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .project-card {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-6);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all var(--transition-normal);
  }

  .project-card:hover {
    background: var(--color-bg-card-hover);
    border-color: var(--color-border-default);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  .project-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-lg);
    background: var(--color-accent-subtle);
    color: var(--color-accent-secondary);
    flex-shrink: 0;
  }

  .project-card__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .project-card__title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
  }

  .project-card__description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .project-card__meta {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-1);
  }

  .project-card__arrow {
    color: var(--color-text-muted);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .project-card:hover .project-card__arrow {
    color: var(--color-accent-secondary);
    transform: translateX(2px);
  }

  .featured-section {
    margin-top: var(--space-8);
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-16);
    text-align: center;
  }

  .empty-state :global(.empty-state__icon) {
    color: var(--color-text-muted);
    opacity: 0.5;
  }

  .empty-state__title {
    font-size: var(--text-xl);
    color: var(--color-text-secondary);
  }

  .empty-state__description {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .load-more {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-10);
  }

  .load-more__text {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .page-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .prompts-grid {
      grid-template-columns: 1fr;
    }

    .page-header__title {
      font-size: var(--text-2xl);
    }

    .project-card {
      padding: var(--space-4);
      gap: var(--space-3);
    }

    .project-card__icon {
      width: 40px;
      height: 40px;
    }
  }
</style>
