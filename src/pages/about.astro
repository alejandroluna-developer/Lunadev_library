---
import MainLayout from '../layouts/MainLayout.astro';
import Breadcrumbs from '../components/molecules/Breadcrumbs.astro';
import CodeBlock from '../components/molecules/CodeBlock.astro';
import Icon from '../components/atoms/Icon.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Acerca de' },
];

const philosophyCode = `const architecture = "Clean & Scalable";
const stack = ["React", "Next.js", "Astro", "Flutter"];
const focus = "Production-Ready AI Integration";

function buildPrompt(intent: string) {
  return prompts.engineer(intent, {
    precision: true,
    deterministic: true,
  });
}`;

const expertise = [
  { title: 'Frontend', description: 'React, Next.js, Angular, Astro, Tailwind CSS', icon: 'layout' },
  { title: 'Mobile', description: 'Flutter, Ionic, React Native', icon: 'smartphone' },
  { title: 'Backend', description: 'Node.js, Firebase, SQL/NoSQL', icon: 'server' },
];

const connectLinks = [
  { label: 'Portafolio', href: 'https://alejandro-luna-miranda.web.app/', icon: 'external-link' },
  { label: 'GitHub', href: 'https://github.com/alejandroluna-developer', icon: 'github' },
];
---

<MainLayout title="Acerca de — LunaPrompt" currentPath="/about">
  <Breadcrumbs items={breadcrumbs} />

  <section class="about-hero">
    <div class="about-hero__content">
      <h1 class="about-hero__title">Acerca de LunaPrompt</h1>
      <p class="about-hero__description">
        Una librería curada de prompts de ingeniería diseñada para desarrolladores que exigen precisión,
        arquitectura limpia y resultados determinísticos en sus interacciones con LLMs.
      </p>
    </div>
  </section>

  <div class="about-grid">
    <section class="mission-card">
      <div class="mission-card__header">
        <div class="mission-card__icon">
          <Icon name="compass" size={20} />
        </div>
        <h2 class="mission-card__title">La Misión</h2>
      </div>
      <p class="mission-card__description">
        LunaPrompt nace de una necesidad real: la brecha entre un prompt que "funciona" y uno
        listo para producción está en la precisión de su ingeniería. Esta librería provee
        frameworks rigurosos para prompt engineering que priorizan resultados determinísticos,
        arquitecturas escalables y eficiencia computacional.
      </p>
      <div class="mission-card__pillars">
        {expertise.map((item) => (
          <div class="pillar">
            <div class="pillar__header">
              <Icon name={item.icon} size={16} />
              <h3 class="pillar__title">{item.title}</h3>
            </div>
            <p class="pillar__description">{item.description}</p>
          </div>
        ))}
      </div>
    </section>

    <div class="about-side">
      <section class="team-card">
        <h2 class="team-card__title">Alejandro Luna</h2>
        <p class="team-card__description">
          Ingeniero de Sistemas de la Universidad de Ibagué. Especialista en Frontend y Mobile
          con experiencia liderando células de desarrollo en el sector financiero y construyendo
          soluciones empresariales de alto impacto.
        </p>
        <p class="team-card__description">
          Combina la rigurosidad técnica del sector bancario con la agilidad de tecnologías modernas,
          diseñando software que impulsa el crecimiento real de los negocios a través de la innovación técnica.
        </p>
        <div class="team-card__author">
          <div class="team-card__avatar">
            <Icon name="users" size={20} />
          </div>
          <div class="team-card__author-info">
            <span class="team-card__author-role">Frontend & Mobile Developer</span>
            <span class="team-card__author-name">@LunaFrontDev</span>
          </div>
        </div>
      </section>

      <section class="connect-card">
        <h2 class="connect-card__title">Conectar</h2>
        <ul class="connect-card__list">
          {connectLinks.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer" class="connect-card__link">
                <span>{link.label}</span>
                <Icon name="external-link" size={14} />
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>

  <section class="philosophy-section">
    <h2 class="philosophy-section__title">Filosofía de Ingeniería</h2>
    <CodeBlock
      code={philosophyCode}
      language="typescript"
      filename="philosophy.ts"
    />
  </section>
</MainLayout>

<style>
  .about-hero {
    margin: var(--space-8) 0;
    padding: var(--space-12) var(--space-8);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-xl);
    text-align: center;
  }

  .about-hero__content {
    max-width: 700px;
    margin-inline: auto;
  }

  .about-hero__title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .about-hero__description {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .mission-card {
    padding: var(--space-8);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .mission-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .mission-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--color-accent-subtle);
    border-radius: var(--radius-md);
    color: var(--color-accent-secondary);
  }

  .mission-card__title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
  }

  .mission-card__description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .mission-card__pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
  }

  .pillar {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .pillar__header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-accent-secondary);
  }

  .pillar__title {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
  }

  .pillar__description {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    line-height: var(--leading-relaxed);
  }

  .about-side {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .team-card {
    padding: var(--space-6);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .team-card__title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
  }

  .team-card__description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .team-card__author {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
  }

  .team-card__avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-default);
    color: var(--color-text-tertiary);
  }

  .team-card__author-info {
    display: flex;
    flex-direction: column;
  }

  .team-card__author-role {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .team-card__author-name {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-primary);
  }

  .connect-card {
    padding: var(--space-6);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .connect-card__title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
  }

  .connect-card__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .connect-card__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border-card);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .connect-card__link:hover {
    background: var(--color-bg-elevated);
    border-color: var(--color-border-default);
    color: var(--color-text-primary);
  }

  .philosophy-section {
    margin-bottom: var(--space-8);
  }

  .philosophy-section__title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  @media (max-width: 1024px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .mission-card__pillars {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .about-hero {
      padding: var(--space-8) var(--space-4);
    }

    .about-hero__title {
      font-size: var(--text-2xl);
    }
  }
</style>
