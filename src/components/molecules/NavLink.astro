---
import Icon from '../atoms/Icon.astro';

interface Props {
  href: string;
  icon?: string;
  label: string;
  isActive?: boolean;
  class?: string;
}

const { href, icon, label, isActive = false, class: className = '' } = Astro.props;
---

<a class:list={['nav-link', { 'nav-link--active': isActive }, className]} href={href}>
  {icon && <Icon name={icon} size={18} class="nav-link__icon" />}
  <span class="nav-link__label">{label}</span>
</a>

<style>
  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .nav-link:hover {
    background: var(--color-bg-elevated);
    color: var(--color-text-primary);
  }

  .nav-link--active {
    background: var(--color-accent-subtle);
    color: var(--color-accent-secondary);
  }

  .nav-link--active .nav-link__icon {
    color: var(--color-accent-primary);
  }

  .nav-link__icon {
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .nav-link:hover .nav-link__icon {
    color: var(--color-text-primary);
  }
</style>
