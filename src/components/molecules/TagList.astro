---
import Badge from '../atoms/Badge.astro';

interface Props {
  tags: string[];
  variant?: 'default' | 'outline';
  class?: string;
}

const { tags, variant = 'default', class: className = '' } = Astro.props;
---

<div class:list={['tag-list', className]}>
  {tags.map((tag) => (
    <Badge variant={variant}>{tag}</Badge>
  ))}
</div>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
