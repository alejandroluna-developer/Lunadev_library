---
import Icon from '../atoms/Icon.astro';
import { footerNavItems } from '../../data/navigation';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<footer class:list={['footer', className]}>
  <div class="footer__inner">
    <div class="footer__left">
      <span class="footer__brand">LunaPrompt</span>
      <span class="footer__copy">© 2025 LunaFrontDev. All rights reserved.</span>
    </div>
    <nav class="footer__nav" aria-label="Footer navigation">
      {footerNavItems.map((item) => (
        <a href={item.href} class="footer__link">{item.label}</a>
      ))}
    </nav>
    <div class="footer__social">
      <a href="#" class="footer__social-link" aria-label="GitHub">
        <Icon name="github" size={18} />
      </a>
      <a href="#" class="footer__social-link" aria-label="Twitter">
        <Icon name="twitter" size={18} />
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border-subtle);
    padding: var(--space-8) var(--space-6);
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--content-max-width);
    margin-inline: auto;
  }

  .footer__left {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .footer__brand {
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    color: var(--color-text-primary);
  }

  .footer__copy {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .footer__nav {
    display: flex;
    gap: var(--space-6);
  }

  .footer__link {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer__link:hover {
    color: var(--color-accent-secondary);
  }

  .footer__social {
    display: flex;
    gap: var(--space-3);
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-default);
    color: var(--color-text-tertiary);
    transition: all var(--transition-fast);
  }

  .footer__social-link:hover {
    color: var(--color-text-primary);
    border-color: var(--color-accent-primary);
  }

  @media (max-width: 768px) {
    .footer__inner {
      flex-direction: column;
      gap: var(--space-4);
      text-align: center;
    }

    .footer__nav {
      gap: var(--space-4);
    }
  }
</style>
