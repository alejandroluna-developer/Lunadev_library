---
interface Props {
  beforeImage: string;
  afterImage: string;
  beforeCaption?: string;
  afterCaption?: string;
  class?: string;
}

const {
  beforeImage,
  afterImage,
  beforeCaption = 'Before',
  afterCaption = 'After',
  class: className = '',
} = Astro.props;
---

<div class:list={['ba-slider', className]} data-ba-slider>
  <div class="ba-slider__container">
    <div class="ba-slider__image ba-slider__image--after">
      <img src={afterImage} alt={afterCaption} loading="lazy" draggable="false" />
      <span class="ba-slider__label ba-slider__label--after">{afterCaption}</span>
    </div>
    <div class="ba-slider__image ba-slider__image--before" data-ba-before>
      <img src={beforeImage} alt={beforeCaption} loading="lazy" draggable="false" />
      <span class="ba-slider__label ba-slider__label--before">{beforeCaption}</span>
    </div>
    <div class="ba-slider__divider" data-ba-divider>
      <div class="ba-slider__handle" aria-label="Drag to compare images" role="slider" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" tabindex="0">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M8 18l-6-6 6-6M16 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  .ba-slider {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border-card);
    user-select: none;
  }

  .ba-slider__container {
    position: relative;
    width: 100%;
    max-width: 640px;
    height: 480px;
    margin-inline: auto;
    overflow: hidden;
    cursor: ew-resize;
    background: var(--color-bg-primary);
  }

  .ba-slider__image--after {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .ba-slider__image--after img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    pointer-events: none;
  }

  .ba-slider__image--before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 50% 0 0);
    z-index: 2;
    overflow: hidden;
  }

  .ba-slider__image--before img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    pointer-events: none;
  }

  .ba-slider__image--before {
    clip-path: inset(0 50% 0 0);
    z-index: 2;
  }

  .ba-slider__image--after {
    z-index: 1;
  }

  .ba-slider__label {
    position: absolute;
    bottom: var(--space-3);
    padding: var(--space-1) var(--space-3);
    background: var(--color-bg-overlay);
    backdrop-filter: blur(8px);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-primary);
    pointer-events: none;
  }

  .ba-slider__label--before {
    left: var(--space-3);
  }

  .ba-slider__label--after {
    right: var(--space-3);
  }

  .ba-slider__divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 3px;
    background: var(--color-text-primary);
    z-index: 3;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .ba-slider__handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: var(--color-bg-primary);
    border: 2px solid var(--color-text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-primary);
    box-shadow: var(--shadow-lg);
    pointer-events: auto;
    cursor: ew-resize;
    transition: transform 0.1s ease;
  }

  .ba-slider__handle:hover,
  .ba-slider__handle:focus-visible {
    transform: translate(-50%, -50%) scale(1.1);
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
  }

  .ba-slider__handle:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }
</style>

<script>
  document.querySelectorAll('[data-ba-slider]').forEach((slider) => {
    const container = slider.querySelector('.ba-slider__container') as HTMLElement;
    const beforeEl = slider.querySelector('[data-ba-before]') as HTMLElement;
    const divider = slider.querySelector('[data-ba-divider]') as HTMLElement;
    const handle = slider.querySelector('.ba-slider__handle') as HTMLElement;

    if (!container || !beforeEl || !divider || !handle) return;

    let isDragging = false;

    function updatePosition(x: number) {
      const rect = container.getBoundingClientRect();
      let percent = ((x - rect.left) / rect.width) * 100;
      percent = Math.max(0, Math.min(100, percent));

      beforeEl.style.clipPath = `inset(0 ${100 - percent}% 0 0)`;
      divider.style.left = `${percent}%`;
      handle.setAttribute('aria-valuenow', String(Math.round(percent)));
    }

    container.addEventListener('mousedown', (e) => {
      isDragging = true;
      updatePosition(e.clientX);
    });

    document.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      e.preventDefault();
      updatePosition(e.clientX);
    });

    document.addEventListener('mouseup', () => {
      isDragging = false;
    });

    container.addEventListener('touchstart', (e) => {
      isDragging = true;
      updatePosition(e.touches[0].clientX);
    }, { passive: true });

    document.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      updatePosition(e.touches[0].clientX);
    }, { passive: true });

    document.addEventListener('touchend', () => {
      isDragging = false;
    });

    // Keyboard accessibility
    handle.addEventListener('keydown', (e) => {
      const current = parseFloat(divider.style.left) || 50;
      let next = current;

      if (e.key === 'ArrowLeft') next = Math.max(0, current - 2);
      else if (e.key === 'ArrowRight') next = Math.min(100, current + 2);
      else return;

      e.preventDefault();
      beforeEl.style.clipPath = `inset(0 ${100 - next}% 0 0)`;
      divider.style.left = `${next}%`;
      handle.setAttribute('aria-valuenow', String(Math.round(next)));
    });
  });
</script>
