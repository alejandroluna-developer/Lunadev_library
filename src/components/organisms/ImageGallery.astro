---
interface GalleryItem {
  src: string;
  caption?: string;
}

interface Props {
  images: GalleryItem[];
  class?: string;
}

const { images, class: className = '' } = Astro.props;
---

<div class:list={['gallery', className]} data-gallery>
  <div class="gallery__featured">
    <img
      src={images[0].src}
      alt={images[0].caption || 'Gallery image'}
      class="gallery__featured-img"
      data-gallery-featured
      loading="lazy"
    />
    {images[0].caption && (
      <span class="gallery__caption" data-gallery-caption>{images[0].caption}</span>
    )}
  </div>

  {images.length > 1 && (
    <div class="gallery__thumbs">
      {images.map((image, index) => (
        <button
          class:list={['gallery__thumb', { 'gallery__thumb--active': index === 0 }]}
          data-gallery-thumb={index}
          aria-label={image.caption || `Image ${index + 1}`}
        >
          <img
            src={image.src}
            alt={image.caption || `Thumbnail ${index + 1}`}
            loading="lazy"
            draggable="false"
          />
        </button>
      ))}
    </div>
  )}
</div>

<style>
  .gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border-card);
    background: var(--color-bg-card);
  }

  .gallery__featured {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-bg-primary);
  }

  .gallery__featured-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity var(--transition-normal);
  }

  .gallery__caption {
    position: absolute;
    bottom: var(--space-3);
    left: var(--space-3);
    right: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg-overlay);
    backdrop-filter: blur(8px);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    text-align: center;
  }

  .gallery__thumbs {
    display: flex;
    gap: var(--space-2);
    padding: var(--space-3);
    overflow-x: auto;
  }

  .gallery__thumb {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 2px solid transparent;
    cursor: pointer;
    padding: 0;
    background: var(--color-bg-elevated);
    transition: border-color var(--transition-fast), opacity var(--transition-fast);
    opacity: 0.6;
  }

  .gallery__thumb:hover {
    opacity: 0.9;
  }

  .gallery__thumb--active {
    border-color: var(--color-accent-primary);
    opacity: 1;
  }

  .gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .gallery__thumb {
      width: 52px;
      height: 52px;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-gallery]').forEach((gallery) => {
    const featured = gallery.querySelector('[data-gallery-featured]') as HTMLImageElement;
    const caption = gallery.querySelector('[data-gallery-caption]') as HTMLElement | null;
    const thumbs = gallery.querySelectorAll('[data-gallery-thumb]');

    if (!featured || thumbs.length === 0) return;

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const img = thumb.querySelector('img') as HTMLImageElement;
        if (!img) return;

        featured.src = img.src;
        featured.alt = img.alt;

        if (caption) {
          const newCaption = img.alt !== `Thumbnail ${parseInt(thumb.getAttribute('data-gallery-thumb')!) + 1}`
            ? img.alt
            : '';
          if (newCaption) {
            caption.textContent = newCaption;
            caption.hidden = false;
          } else {
            caption.hidden = true;
          }
        }

        thumbs.forEach((t) => t.classList.remove('gallery__thumb--active'));
        thumb.classList.add('gallery__thumb--active');
      });
    });
  });
</script>
